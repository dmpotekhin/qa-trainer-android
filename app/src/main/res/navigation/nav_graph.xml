<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/nav_basics">

    <fragment
        android:id="@+id/nav_basics"
        android:name="com.example.qatrainer.ui.basics.BasicsFragment"
        android:label="Basics" />
    <fragment
        android:id="@+id/nav_forms"
        android:name="com.example.qatrainer.ui.forms.FormsFragment"
        android:label="Forms" />
    <fragment
        android:id="@+id/nav_lists"
        android:name="com.example.qatrainer.ui.lists.ListsFragment"
        android:label="Lists" />
    <fragment
        android:id="@+id/nav_detail"
        android:name="com.example.qatrainer.ui.detail.DetailFragment"
        android:label="Detail">
        <argument android:name="itemId" app:argType="integer" />
        <argument android:name="itemTitle" app:argType="string" />
        <argument android:name="itemDesc" app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/nav_gestures"
        android:name="com.example.qatrainer.ui.gestures.GesturesFragment"
        android:label="Gestures" />
    <fragment
        android:id="@+id/nav_challenges"
        android:name="com.example.qatrainer.ui.challenges.ChallengesFragment"
        android:label="Challenges" />
</navigation>
